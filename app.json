{
  "expo": {
    "name": "Katchup",
    "slug": "katchup-fe",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "katchup",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.katchup.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        }
      }
    },
    "android": {
      "edgeToEdgeEnabled": true,
      "package": "com.katchup.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/katchup-logo2.png"
    },
    "plugins": [
      "expo-router",
      "expo-web-browser",
      "expo-secure-store"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d45e4b5-e5ee-4cdd-8e4e-b66d94ded0c7"
      }
    },
    "owner": "judy59"
  }
}
